    "cmdk": "1.1.1",
    "cn": "^0.5.0",
    "d3-force": "3.0.0",
    "elkjs": "0.12.0",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.0",
